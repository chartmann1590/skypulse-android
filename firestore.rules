rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function recentSignIn() {
      return request.auth != null && request.auth.token.auth_time is int
        && request.auth.token.auth_time * 1000 >= request.time.toMillis() - 300000;
    }
    function deletionPath(uid) {
      return /databases/$(database)/documents/account_deletions/$(uid);
    }
    function sharePath(id) {
      return /databases/$(database)/documents/shared_flights/$(id);
    }
    function shareRefPath(uid, id) {
      return /databases/$(database)/documents/users/$(uid)/shared_flight_refs/$(id);
    }
    function acceptsWrites() {
      return request.auth != null && !existsAfter(deletionPath(request.auth.uid));
    }
    function deletingOwnData() {
      return request.auth != null && exists(deletionPath(request.auth.uid));
    }
    function validShare() {
      return request.resource.data.size() <= 40
        && request.resource.data.createdAt == request.time
        && request.resource.data.lat is number && request.resource.data.lon is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lon >= -180 && request.resource.data.lon <= 180;
    }
    function indexedShareCreated(id) {
      let ref = shareRefPath(request.auth.uid, id);
      return !request.resource.data.keys().hasAny(['sharedBy'])
        && !exists(ref) && existsAfter(ref);
    }
    function mayDeleteShare(id) {
      let ref = shareRefPath(request.auth.uid, id);
      return (resource.data.keys().hasAny(['sharedBy']) && owns(resource.data.sharedBy))
        || (!resource.data.keys().hasAny(['sharedBy']) && exists(ref) && !existsAfter(ref));
    }

    match /account_deletions/{uid} {
      // No contact details or deletion contents. Keep this write barrier so an old
      // device/session cannot recreate a deleted account's saved data or share links.
      allow get: if owns(uid);
      allow create: if owns(uid) && recentSignIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow list, update, delete: if false;
    }

    match /shared_flights/{id} {
      // Public snapshots remain readable. New clients keep the owner reference private.
      allow read: if true;
      allow create: if acceptsWrites() && validShare() && (
        indexedShareCreated(id)
        || (request.resource.data.keys().hasAny(['sharedBy'])
          && owns(request.resource.data.sharedBy))
      );
      allow delete: if deletingOwnData() && mayDeleteShare(id);
      allow update: if false;
    }

    match /users/{uid}/shared_flight_refs/{id} {
      allow read: if owns(uid);
      // The private reference and a genuinely new public snapshot must be created together.
      allow create: if owns(uid) && acceptsWrites() && !exists(sharePath(id))
        && existsAfter(sharePath(id))
        && !getAfter(sharePath(id)).data.keys().hasAny(['sharedBy'])
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow delete: if owns(uid) && deletingOwnData() && !existsAfter(sharePath(id));
      allow update: if false;
    }

    match /users/{uid}/{group}/{item} {
      function isSavedCollection() {
        return group in ['saved_aircraft', 'saved_airports', 'saved_areas'];
      }
      allow read, delete: if owns(uid) && isSavedCollection();
      allow create, update: if owns(uid) && isSavedCollection() && acceptsWrites();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
